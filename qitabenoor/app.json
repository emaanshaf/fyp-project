{
  "expo": {
    "name": "Qitab-e-Noor",
    "slug": "qitab-e-noor",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "App needs location for prayer times"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2E7D32"
      },
      "permissions": ["ACCESS_FINE_LOCATION"]
    }
  }
}